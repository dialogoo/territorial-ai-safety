{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/regenerate_book_content.py\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Regenerating book content..."
          }
        ]
      }
    ]
  }
}
